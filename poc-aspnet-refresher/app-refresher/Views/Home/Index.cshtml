@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-panel mb-4 mb-lg-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <p class="eyebrow">Remote Careers Platform</p>
            <h1 class="display-5 mb-3">Find meaningful remote work with teams you can trust.</h1>
            <p class="lead mb-0">We help professionals discover vetted remote opportunities, sharpen their profile, and
                connect with companies building distributed cultures.</p>
            </div>
            <div class="col-lg-5">
                <div class="hero-card">
                    <h2 class="h5 mb-3">What you can expect</h2>
                    <ul class="mb-0">
                        <li>Curated global job opportunities</li>
                        <li>Fast application workflow</li>
                        <li>Professional profile support</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4 mb-lg-5">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h2 class="section-title mb-0">Success Stories</h2>
            <span class="text-muted">Real outcomes from our members</span>
        </div>
        <div class="row g-3">
            @foreach (var testimonial in Model.Testimonials)
            {
                <div class="col-md-4 d-flex">
                    <article class="testimonial-card w-100">
                        <p class="testimonial-quote">"@testimonial.Quote"</p>
                        <p class="mb-0 fw-semibold">@testimonial.PersonName</p>
                        <p class="mb-0 text-muted small">@testimonial.Role</p>
                    </article>
                </div>
            }
        </div>
    </section>

    <section id="contact-us" class="contact-panel">
        <div class="row g-4">
            <div class="col-lg-5">
                <h2 class="section-title">Contact Us</h2>
                <p class="text-muted mb-0">Share what type of remote role you are pursuing and we will help guide your next
                    steps.</p>
                </div>
                <div class="col-lg-7">
                    @if (TempData["ContactSuccess"] is string message)
                    {
                        <div class="alert alert-success" role="alert">@message</div>
                    }

                    <form asp-controller="Home" asp-action="SubmitContact" method="post" class="contact-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="ContactForm.Name" class="form-label"></label>
                            <input asp-for="ContactForm.Name" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="ContactForm.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactForm.Message" class="form-label"></label>
                            <textarea asp-for="ContactForm.Message" class="form-control" rows="5"
                                      placeholder="Tell us about your goals"></textarea>
                            <span asp-validation-for="ContactForm.Message" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary px-4">Submit</button>
                    </form>
                </div>
            </div>
        </section>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
