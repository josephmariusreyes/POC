@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row g-4">
    <div class="col-lg-8">
        <section class="content-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">Profile</h1>
                <span class="role-badge">@Model.Role</span>
            </div>

            @if (TempData["ProfileUpdated"] is string message)
            {
                <div class="alert alert-success" role="alert">@message</div>
            }

            <form asp-controller="Profile" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="Role" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="content-panel h-100">
            <h2 class="h5 mb-3">Employment History</h2>
            @if (Model.EmploymentHistory.Any())
            {
                <div class="timeline">
                    @foreach (var item in Model.EmploymentHistory.OrderByDescending(x => x.StartDate))
                    {
                        <article class="timeline-item">
                            <p class="fw-semibold mb-1">@item.Position</p>
                            <p class="mb-1">@item.Company</p>
                            <p class="text-muted small mb-1">@item.StartDate.ToString("yyyy-MM-dd") -
                                @item.EndDate.ToString("yyyy-MM-dd")</p>
                                <p class="text-muted small mb-0">Salary: @item.Salary.ToString("C0")</p>
                            </article>
                        }
                    </div>
                }
            else
                {
                    <p class="text-muted mb-0">No employment history available.</p>
                }
            </section>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
